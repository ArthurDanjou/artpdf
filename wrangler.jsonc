{
  // Deploiement BentoPDF sur Worker + Static Assets.
  // Ce fichier est copie a la racine du build upstream par le workflow
  // avant `wrangler deploy` : les chemins relatifs sont donc resolus
  // depuis la racine upstream (./worker.js, ./dist).
  "name": "bentopdf",
  "main": "./worker.js",
  // Date de compatibilite : ne pas reculer sans tester (runtime changes).
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
  // Domaine custom (optionnel) : ajouter par exemple
  // "routes": [{ "pattern": "pdf.example.com/*", "zone_name": "example.com" }]
}
